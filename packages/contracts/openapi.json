{
  "components": {
    "schemas": {
      "ConversationDetailOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunOut"
            },
            "title": "Runs",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at",
          "runs"
        ],
        "title": "ConversationDetailOut",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationOut",
        "type": "object"
      },
      "FeedbackIn": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "rating": {
            "enum": [
              "HELPFUL",
              "NOT_HELPFUL"
            ],
            "title": "Rating",
            "type": "string"
          }
        },
        "required": [
          "rating"
        ],
        "title": "FeedbackIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "database"
        ],
        "title": "Health",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "warehouse_manager",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "sites": {
            "items": {
              "$ref": "#/components/schemas/SiteOut"
            },
            "title": "Sites",
            "type": "array"
          }
        },
        "required": [
          "name",
          "role",
          "sites"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "PageContext": {
        "additionalProperties": false,
        "description": "What the user is looking at. Context for the model only, never used to authorize.",
        "properties": {
          "selected_bin": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Bin"
          },
          "selected_zone": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Zone"
          }
        },
        "title": "PageContext",
        "type": "object"
      },
      "RunIn": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "page_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "question": {
            "maxLength": 4000,
            "title": "Question",
            "type": "string"
          },
          "site_id": {
            "format": "uuid",
            "title": "Site Id",
            "type": "string"
          },
          "suggestion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SuggestionIn"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "site_id",
          "question"
        ],
        "title": "RunIn",
        "type": "object"
      },
      "RunOut": {
        "properties": {
          "answer_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Text"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "results": {
            "items": {},
            "title": "Results",
            "type": "array"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "suggestions": {
            "items": {},
            "title": "Suggestions",
            "type": "array"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "seq",
          "question",
          "path",
          "status",
          "outcome",
          "answer_text",
          "results",
          "suggestions",
          "trace_id",
          "created_at",
          "finished_at"
        ],
        "title": "RunOut",
        "type": "object"
      },
      "SiteOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ],
        "title": "SiteOut",
        "type": "object"
      },
      "SiteStatusOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data_status": {
            "title": "Data Status",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sim_time": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sim Time"
          }
        },
        "required": [
          "code",
          "name",
          "data_status",
          "sim_time"
        ],
        "title": "SiteStatusOut",
        "type": "object"
      },
      "SuggestionIn": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxProperties": 10,
            "title": "Arguments",
            "type": "object"
          },
          "label": {
            "maxLength": 200,
            "title": "Label",
            "type": "string"
          },
          "tool": {
            "pattern": "^[a-z][a-z_]{0,63}$",
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "label",
          "tool",
          "arguments"
        ],
        "title": "SuggestionIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PalletWise API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/callback": {
      "get": {
        "operationId": "callback_api_auth_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 128,
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 4096,
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Callback"
      }
    },
    "/api/auth/login": {
      "get": {
        "operationId": "login_api_auth_login_get",
        "parameters": [
          {
            "in": "query",
            "name": "return_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Return To"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/copilot/conversations": {
      "get": {
        "operationId": "conversations_api_copilot_conversations_get",
        "parameters": [
          {
            "in": "query",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationOut"
                  },
                  "title": "Response Conversations Api Copilot Conversations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Conversations",
        "tags": [
          "copilot"
        ]
      }
    },
    "/api/copilot/conversations/{conversation_id}": {
      "get": {
        "operationId": "conversation_api_copilot_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Conversation",
        "tags": [
          "copilot"
        ]
      }
    },
    "/api/copilot/runs": {
      "post": {
        "operationId": "start_run_api_copilot_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Run events (agent spec 9.1)"
          },
          "403": {
            "description": "FORBIDDEN"
          },
          "404": {
            "description": "NOT_FOUND"
          },
          "422": {
            "description": "VALIDATION_FAILED"
          },
          "429": {
            "description": "RATE_LIMITED"
          },
          "503": {
            "description": "DATA_NOT_READY, COPILOT_SUSPENDED or UNAVAILABLE"
          }
        },
        "summary": "Start Run",
        "tags": [
          "copilot"
        ]
      }
    },
    "/api/copilot/runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancel_run_api_copilot_runs__run_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Run",
        "tags": [
          "copilot"
        ]
      }
    },
    "/api/copilot/runs/{run_id}/feedback": {
      "post": {
        "operationId": "feedback_api_copilot_runs__run_id__feedback_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Feedback",
        "tags": [
          "copilot"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/me": {
      "get": {
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me"
      }
    },
    "/api/sites/{site_id}/status": {
      "get": {
        "operationId": "site_status_api_sites__site_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteStatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not one of your sites, or not created yet"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Site Status"
      }
    }
  }
}
