# PalletWise local configuration. Copy to .env and replace every "change-me" value.
# .env is ignored by git. Never commit real credentials.

# ---- PostgreSQL superuser, used only by the bootstrap step of `migrate`
PW_BOOTSTRAP_USER=postgres
PW_BOOTSTRAP_PASSWORD=change-me

# ---- One password per database role (canonical model 11.3)
PW_MIGRATOR_PASSWORD=change-me
PW_APP_PASSWORD=change-me
PW_INGEST_PASSWORD=change-me
PW_EVALUATOR_PASSWORD=change-me
PW_PROPOSAL_WRITER_PASSWORD=change-me
PW_WORKFLOW_PASSWORD=change-me
PW_SIM_ADMIN_PASSWORD=change-me
PW_AGENT_READ_PASSWORD=change-me
PW_MEMORY_PASSWORD=change-me
SIM_OWNER_PASSWORD=change-me
SIM_OUTBOX_READER_PASSWORD=change-me

# ---- Keycloak (development realm only; never used outside local development)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
KC_DEV_MANAGER_PASSWORD=change-me
KC_DEV_ADMIN_PASSWORD=change-me
KC_BFF_CLIENT_SECRET=change-me
KC_COPILOT_CLIENT_SECRET=change-me

# ---- Simulation
PW_SIM_SEED=42

# ---- Optional: Gemini on Vertex AI (Slice 1). Without it the copilot uses template answers.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repository/sa.json

# ---- Optional: Langfuse export (Slice 1). Without it telemetry export is disabled.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ---- Host ports (defaults avoid clashing with other local stacks)
PW_EDGE_HOST_PORT=8080
PW_POSTGRES_HOST_PORT=5433
PW_KEYCLOAK_HOST_PORT=8180
